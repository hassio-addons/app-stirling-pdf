#!/command/with-contenv bashio
# shellcheck shell=bash
# ==============================================================================
# Home Assistant Community App: Stirling PDF
# Configures NGINX for use with Stirling PDF
# ==============================================================================

# Generate Ingress configuration
bashio::var.json \
    interface "$(bashio::app.ip_address)" \
    port "^$(bashio::app.ingress_port)" \
    | tempio \
        -template /etc/nginx/templates/ingress.gtpl \
        -out /etc/nginx/servers/ingress.conf

# Generate direct access configuration, if enabled.
if bashio::var.has_value "$(bashio::app.port 8080)"; then
    bashio::config.require.ssl

    # Ingress is authenticated by Home Assistant, the direct port is not. This
    # build of Stirling PDF has no login of its own, so requests arriving here
    # are checked against Home Assistant instead. A browser is asked for a
    # username and password; a script talking to the API sends the same
    # credentials as Basic auth.
    if bashio::config.true 'leave_front_door_open'; then
        bashio::log.warning
        bashio::log.warning "Authentication on the direct port is turned off!"
        bashio::log.warning "Anybody who can reach port $(bashio::app.port 8080)"
        bashio::log.warning "on this machine can use every tool on it, and read"
        bashio::log.warning "every document that passes through it."
        bashio::log.warning
    fi

    bashio::var.json \
        certfile "$(bashio::config 'certfile')" \
        keyfile "$(bashio::config 'keyfile')" \
        leave_front_door_open "^$(bashio::config 'leave_front_door_open' 'false')" \
        port "^8080" \
        ssl "^$(bashio::config 'ssl')" \
        | tempio \
            -template /etc/nginx/templates/direct.gtpl \
            -out /etc/nginx/servers/direct.conf
fi
